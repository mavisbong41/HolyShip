# =============================================================================
# HolyShip Environment Configuration
# =============================================================================

# -----------------------------------------------------------------------------
# 1. Dataset & Storage Settings
# -----------------------------------------------------------------------------
ORGANIZER_BUNDLE_PATH=data/bundle
DATABASE_URL=postgresql+psycopg://holyship:holyship@localhost:5432/holyship_dev
HOLYSHIP_TEST_DATABASE_URL=postgresql+psycopg://holyship:holyship@localhost:5432/holyship_test
HOLYSHIP_EVAL_DATABASE_URL=postgresql+psycopg://holyship:holyship@localhost:5432/holyship_eval
POSTGRES_DB=holyship_dev
POSTGRES_USER=holyship
POSTGRES_PASSWORD=holyship

# -----------------------------------------------------------------------------
# 2. Pipeline Concurrency & Classification Thresholds
# -----------------------------------------------------------------------------
CLASSIFICATION_THRESHOLD=0.8
CLASSIFICATION_MARGIN_THRESHOLD=0.25
SYNC_MAX_WORKERS=4
EXTRACTION_MAX_WORKERS=2
MAX_ATTACHMENT_BYTES=26214400
ORGANIZER_HTTP_TIMEOUT_SECONDS=10
RETRY_MAX_ATTEMPTS=3
RETRY_BACKOFF_SECONDS=0.25
SEMANTIC_RESOLVER_TIMEOUT_SECONDS=5

# -----------------------------------------------------------------------------
# 3. Continuous Polling & Background Ingestion
# -----------------------------------------------------------------------------
INITIAL_SYNC_ON_STARTUP=false
CONTINUOUS_POLLING_ENABLED=false
POLLING_INTERVAL_SECONDS=60
POLLING_BACKOFF_INITIAL_SECONDS=1
POLLING_BACKOFF_MAX_SECONDS=60
POLLING_SOURCE_TYPE=STATIC_BUNDLE
POLLING_ORGANIZER_HTTP_URL=

# -----------------------------------------------------------------------------
# 4. OCR Engine Configuration (Scanned PDFs and Images)
# -----------------------------------------------------------------------------
# Path to Tesseract executable (leave empty for automatic detection from PATH)
OCR_TESSERACT_CMD=
OCR_TIMEOUT_SECONDS=15
OCR_MAX_CALLS=8
OCR_MAX_CONCURRENT_CALLS=2

# -----------------------------------------------------------------------------
# 5. Core Pipeline L2 Semantic AI Escalation (Disabled by default)
# Keep disabled for pure deterministic comparison; enable only for LLM fallback
# -----------------------------------------------------------------------------
AI_ESCALATION_ENABLED=false
AI_PROVIDER=disabled
AI_MODEL=none
AI_ENDPOINT=
AI_API_KEY=
AI_CONFIDENCE_THRESHOLD=0.9
AI_TIMEOUT_SECONDS=5
AI_MAX_CALLS_PER_CASE=2
AI_MAX_CONCURRENT_CALLS=2
AI_RESOLVER_VERSION=phase6-resolver-v1
AI_PROMPT_SCHEMA_VERSION=phase6-schema-v1

# -----------------------------------------------------------------------------
# 6. HolyShip AI Human Review Assistant (Enabled by default)
# Assists human operators with grounded explanations and field suggestions
# -----------------------------------------------------------------------------
AI_REVIEW_ENABLED=true
AI_REVIEW_PROVIDER=auto
AI_REVIEW_MODEL=gemini-2.5-flash
AI_REVIEW_ENDPOINT=
AI_REVIEW_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
AI_REVIEW_TIMEOUT_SECONDS=15
AI_REVIEW_CONFIDENCE_THRESHOLD=0.8
AI_REVIEW_MAX_TOKENS=2048
AI_REVIEW_TEMPERATURE=0.0

# -----------------------------------------------------------------------------
# 7. Enterprise AI Security
# Production should keep Enterprise Privacy Mode enabled. This is a backend
# policy control, not an end-user toggle.
# -----------------------------------------------------------------------------
ENTERPRISE_PRIVACY_MODE=true
# Production defaults approve only Google's Gemini transport. Add providers only
# after explicitly approving their disclosure/transport path.
AI_GATEWAY_ALLOWED_PROVIDERS=gemini,google
# Empty means any model under an approved provider. Production may pin models.
AI_GATEWAY_ALLOWED_MODELS=
AI_GATEWAY_ALLOWED_ENDPOINT_HOSTS=generativelanguage.googleapis.com
AI_GATEWAY_MAX_PAYLOAD_BYTES=65536

# -----------------------------------------------------------------------------
# 8. Web Dashboard & Outlook Add-in CORS
# -----------------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174,http://localhost:3000,http://127.0.0.1:3000,http://localhost:4173,http://127.0.0.1:4173,https://localhost:3200,https://127.0.0.1:3200
