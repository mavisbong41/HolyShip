{
  "1": "import {",
  "2": "  AlertTriangle,",
  "3": "  Archive,",
  "4": "  ChevronLeft,",
  "5": "  ChevronRight,",
  "6": "  CircleCheck,",
  "7": "  ClipboardList,",
  "8": "  FileSearch,",
  "9": "  Inbox,",
  "10": "  MailCheck,",
  "11": "  RefreshCw,",
  "12": "  Search,",
  "13": "  ShieldAlert,",
  "14": "  ShipWheel,",
  "15": "} from \"lucide-react\";",
  "16": "import type React from \"react\";",
  "17": "import { useCallback, useEffect, useMemo, useState } from \"react\";",
  "18": "import {",
  "19": "  getEmailDetail,",
  "20": "  getEmailQueue,",
  "21": "  getEvents,",
  "22": "  getHumanReviewQueue,",
  "23": "  getSummary,",
  "24": "} from \"./api/client\";",
  "25": "import type {",
  "26": "  EmailQueuePage,",
  "27": "  HumanReviewPage,",
  "28": "  ProcessingStatus,",
  "29": "  ProductCategory,",
  "30": "  ProductEmailDetail,",
  "31": "  ProductEmailSummary,",
  "32": "  ProductSummary,",
  "33": "  QueueFilters,",
  "34": "} from \"./api/types\";",
  "35": "import { canonicalFields } from \"./api/types\";",
  "36": "import {",
  "37": "  categoryLabels,",
  "38": "  displayValue,",
  "39": "  fieldStatusLabels,",
  "40": "  formatDate,",
  "41": "  labelForField,",
  "42": "  readinessLabels,",
  "43": "  statusLabels,",
  "44": "} from \"./lib/labels\";",
  "45": "",
  "46": "type Page = \"overview\" | \"queue\" | \"review\";",
  "47": "type LoadState = \"idle\" | \"loading\" | \"ready\" | \"error\";",
  "48": "",
  "49": "const pageTitles: Record<Page, string> = {",
  "50": "  overview: \"Overview\",",
  "51": "  queue: \"Email Queue\",",
  "52": "  review: \"Human Review\",",
  "53": "};",
  "54": "",
  "55": "const statusOptions: ProcessingStatus[] = [",
  "56": "  \"NEW\",",
  "57": "  \"QUEUED\",",
  "58": "  \"CLASSIFYING\",",
  "59": "  \"AWAITING_DOCUMENTS\",",
  "60": "  \"RETRIEVING_ATTACHMENTS\",",
  "61": "  \"EXTRACTING\",",
  "62": "  \"COMPARING\",",
  "63": "  \"COMPLETED\",",
  "64": "  \"BLOCKED\",",
  "65": "  \"FAILED\",",
  "66": "];",
  "67": "",
  "68": "const categoryOptions: ProductCategory[] = [",
  "69": "  \"document_comparison\",",
  "70": "  \"new_si_request\",",
  "71": "  \"invoice_query\",",
  "72": "  \"general_message\",",
  "73": "  \"spam\",",
  "74": "];",
  "75": "",
  "76": "function cx(...items: Array<string | false | null | undefined>): string {",
  "77": "  return items.filter(Boolean).join(\" \");",
  "78": "}",
  "79": "",
  "80": "function metricFromStatus(summary: ProductSummary | null, status: ProcessingStatus): number {",
  "81": "  return summary?.status_counts[status] ?? 0;",
  "82": "}",
  "83": "",
  "84": "function StatusBadge({",
  "85": "  value,",
  "86": "  tone,",
  "87": "}: {",
  "88": "  value: string | null | undefined;",
  "89": "  tone?: \"neutral\" | \"good\" | \"warn\" | \"bad\" | \"attention\";",
  "90": "}) {",
  "91": "  if (!value) return <span className=\"badge badge-muted\">Not set</span>;",
  "92": "  const resolvedTone =",
  "93": "    tone ??",
  "94": "    (value === \"FAILED\"",
  "95": "      ? \"bad\"",
  "96": "      : value === \"BLOCKED\"",
  "97": "        ? \"attention\"",
  "98": "        : value === \"AWAITING_DOCUMENTS\" || value === \"UNRESOLVED\"",
  "99": "          ? \"warn\"",
  "100": "          : value === \"COMPLETED\" || value === \"MATCH\"",
  "101": "            ? \"good\"",
  "102": "            : \"neutral\");",
  "103": "  const label =",
  "104": "    value in statusLabels",
  "105": "      ? statusLabels[value as ProcessingStatus]",
  "106": "      : value in categoryLabels",
  "107": "        ? categoryLabels[value as ProductCategory]",
  "108": "        : value.replaceAll(\"_\", \" \");",
  "109": "  return <span className={`badge badge-${resolvedTone}`}>{label}</span>;",
  "110": "}",
  "111": "",
  "112": "function EmptyState({ title, body }: { title: string; body: string }) {",
  "113": "  return (",
  "114": "    <div className=\"empty-state\">",
  "115": "      <Archive aria-hidden=\"true\" size={28} />",
  "116": "      <h3>{title}</h3>",
  "117": "      <p>{body}</p>",
  "118": "    </div>",
  "119": "  );",
  "120": "}",
  "121": "",
  "122": "function LoadingRows() {",
  "123": "  return (",
  "124": "    <div className=\"skeleton-stack\" aria-label=\"Loading\">",
  "125": "      {Array.from({ length: 5 }).map((_, index) => (",
  "126": "        <div className=\"skeleton-row\" key={index} />",
  "127": "      ))}",
  "128": "    </div>",
  "129": "  );",
  "130": "}",
  "131": "",
  "132": "function OverviewPage({",
  "133": "  summary,",
  "134": "  queue,",
  "135": "  state,",
  "136": "  onOpenQueue,",
  "137": "}: {",
  "138": "  summary: ProductSummary | null;",
  "139": "  queue: EmailQueuePage | null;",
  "140": "  state: LoadState;",
  "141": "  onOpenQueue: () => void;",
  "142": "}) {",
  "143": "  const totalKnownStatuses = useMemo(",
  "144": "    () =>",
  "145": "      statusOptions.reduce(",
  "146": "        (total, status) => total + (summary?.status_counts[status] ?? 0),",
  "147": "        0,",
  "148": "      ),",
  "149": "    [summary],",
  "150": "  );",
  "151": "  const completed = metricFromStatus(summary, \"COMPLETED\");",
  "152": "  const completionRate =",
  "153": "    summary && summary.total_emails > 0",
  "154": "      ? Math.round((completed / summary.total_emails) * 100)",
  "155": "      : 0;",
  "156": "",
  "157": "  return (",
  "158": "    <section className=\"page-grid\">",
  "159": "      <div className=\"hero-panel\">",
  "160": "        <div>",
  "161": "          <p className=\"eyebrow\">Shared backend state</p>",
  "162": "          <h1>Shipping document operations, at a glance.</h1>",
  "163": "          <p>",
  "164": "            Live case status, comparison readiness, and human-review signals are",
  "165": "            read from the verified backend contract.",
  "166": "          </p>",
  "167": "        </div>",
  "168": "        <button className=\"primary-action\" onClick={onOpenQueue} type=\"button\">",
  "169": "          <Inbox size={18} />",
  "170": "          Open Queue",
  "171": "        </button>",
  "172": "      </div>",
  "173": "",
  "174": "      <div className=\"metric-grid\" aria-label=\"Operational summary\">",
  "175": "        <MetricCard",
  "176": "          icon={<MailCheck size={19} />}",
  "177": "          label=\"Total Emails\"",
  "178": "          value={summary?.total_emails ?? 0}",
  "179": "          detail={`${totalKnownStatuses} with persisted status`}",
  "180": "        />",
  "181": "        <MetricCard",
  "182": "          icon={<CircleCheck size={19} />}",
  "183": "          label=\"Completed\"",
  "184": "          value={completed}",
  "185": "          detail={`${completionRate}% of current cases`}",
  "186": "          tone=\"good\"",
  "187": "        />",
  "188": "        <MetricCard",
  "189": "          icon={<ShieldAlert size={19} />}",
  "190": "          label=\"Needs Review\"",
  "191": "          value={summary?.needs_review_count ?? 0}",
  "192": "          detail=\"Blocked, failed, or open review\"",
  "193": "          tone=\"attention\"",
  "194": "        />",
  "195": "        <MetricCard",
  "196": "          icon={<AlertTriangle size={19} />}",
  "197": "          label=\"Mismatch\"",
  "198": "          value={summary?.mismatch_count ?? 0}",
  "199": "          detail={`${summary?.unresolved_count ?? 0} unresolved fields`}",
  "200": "          tone=\"warn\"",
  "201": "        />",
  "202": "      </div>",
  "203": "",
  "204": "      <div className=\"split-grid\">",
  "205": "        <section className=\"surface-panel\">",
  "206": "          <div className=\"section-header\">",
  "207": "            <div>",
  "208": "              <p className=\"eyebrow\">Status distribution</p>",
  "209": "              <h2>Processing Load</h2>",
  "210": "            </div>",
  "211": "          </div>",
  "212": "          {state === \"loading\" ? (",
  "213": "            <LoadingRows />",
  "214": "          ) : (",
  "215": "            <div className=\"status-bars\">",
  "216": "              {statusOptions.map((status) => (",
  "217": "                <StatusBar",
  "218": "                  key={status}",
  "219": "                  label={statusLabels[status]}",
  "220": "                  value={summary?.status_counts[status] ?? 0}",
  "221": "                  total={summary?.total_emails ?? 0}",
  "222": "                />",
  "223": "              ))}",
  "224": "            </div>",
  "225": "          )}",
  "226": "        </section>",
  "227": "",
  "228": "        <section className=\"surface-panel\">",
  "229": "          <div className=\"section-header\">",
  "230": "            <div>",
  "231": "              <p className=\"eyebrow\">Newest cases</p>",
  "232": "              <h2>Recent Activity</h2>",
  "233": "            </div>",
  "234": "          </div>",
  "235": "          {queue?.items.length ? (",
  "236": "            <div className=\"activity-list\">",
  "237": "              {queue.items.slice(0, 5).map((item) => (",
  "238": "                <div className=\"activity-item\" key={item.id}>",
  "239": "                  <span className=\"activity-dot\" />",
  "240": "                  <div>",
  "241": "                    <strong>{item.subject}</strong>",
  "242": "                    <p>",
  "243": "                      {item.sender || \"Unknown sender\"} ·{\" \"}",
  "244": "                      {formatDate(item.received_at || item.created_at)}",
  "245": "                    </p>",
  "246": "                  </div>",
  "247": "                  <StatusBadge value={item.processing_status} />",
  "248": "                </div>",
  "249": "              ))}",
  "250": "            </div>",
  "251": "          ) : (",
  "252": "            <EmptyState",
  "253": "              title=\"No recent cases\"",
  "254": "              body=\"Run initial sync or ingest an email to populate this list.\"",
  "255": "            />",
  "256": "          )}",
  "257": "        </section>",
  "258": "      </div>",
  "259": "    </section>",
  "260": "  );",
  "261": "}",
  "262": "",
  "263": "function MetricCard({",
  "264": "  icon,",
  "265": "  label,",
  "266": "  value,",
  "267": "  detail,",
  "268": "  tone = \"neutral\",",
  "269": "}: {",
  "270": "  icon: React.ReactNode;",
  "271": "  label: string;",
  "272": "  value: number;",
  "273": "  detail: string;",
  "274": "  tone?: \"neutral\" | \"good\" | \"warn\" | \"attention\";",
  "275": "}) {",
  "276": "  return (",
  "277": "    <article className={`metric-card metric-${tone}`}>",
  "278": "      <div className=\"metric-icon\">{icon}</div>",
  "279": "      <div>",
  "280": "        <p>{label}</p>",
  "281": "        <strong>{value.toLocaleString()}</strong>",
  "282": "        <span>{detail}</span>",
  "283": "      </div>",
  "284": "    </article>",
  "285": "  );",
  "286": "}",
  "287": "",
  "288": "function StatusBar({ label, value, total }: { label: string; value: number; total: number }) {",
  "289": "  const percent = total > 0 ? Math.round((value / total) * 100) : 0;",
  "290": "  return (",
  "291": "    <div className=\"status-bar\">",
  "292": "      <div className=\"status-bar-label\">",
  "293": "        <span>{label}</span>",
  "294": "        <strong>{value}</strong>",
  "295": "      </div>",
  "296": "      <div className=\"bar-track\" aria-hidden=\"true\">",
  "297": "        <span style={{ width: `${percent}%` }} />",
  "298": "      </div>",
  "299": "    </div>",
  "300": "  );",
  "301": "}",
  "302": "",
  "303": "function QueuePage({",
  "304": "  page,",
  "305": "  queue,",
  "306": "  detail,",
  "307": "  detailState,",
  "308": "  queueState,",
  "309": "  filters,",
  "310": "  onFilters,",
  "311": "  onSelect,",
  "312": "  onPage,",
  "313": "}: {",
  "314": "  page: number;",
  "315": "  queue: EmailQueuePage | null;",
  "316": "  detail: ProductEmailDetail | null;",
  "317": "  detailState: LoadState;",
  "318": "  queueState: LoadState;",
  "319": "  filters: QueueFilters;",
  "320": "  onFilters: (filters: QueueFilters) => void;",
  "321": "  onSelect: (email: ProductEmailSummary) => void;",
  "322": "  onPage: (direction: \"next\" | \"previous\") => void;",
  "323": "}) {",
  "324": "  const pageSize = filters.limit ?? 25;",
  "325": "  const canPrevious = page > 0;",
  "326": "  const canNext = queue ? queue.skip + pageSize < queue.total : false;",
  "327": "",
  "328": "  return (",
  "329": "    <section className=\"queue-layout\">",
  "330": "      <div className=\"surface-panel queue-panel\">",
  "331": "        <div className=\"section-header queue-header\">",
  "332": "          <div>",
  "333": "            <p className=\"eyebrow\">Operational queue</p>",
  "334": "            <h1>Email Queue</h1>",
  "335": "          </div>",
  "336": "          <span className=\"total-pill\">{queue?.total ?? 0} cases</span>",
  "337": "        </div>",
  "338": "",
  "339": "        <div className=\"filters\" aria-label=\"Queue filters\">",
  "340": "          <label>",
  "341": "            <Search size={16} aria-hidden=\"true\" />",
  "342": "            <input",
  "343": "              aria-label=\"Search queue\"",
  "344": "              placeholder=\"Search sender, subject, reference\"",
  "345": "              value={filters.search ?? \"\"}",
  "346": "              onChange={(event) => onFilters({ ...filters, search: event.target.value, skip: 0 })}",
  "347": "            />",
  "348": "          </label>",
  "349": "          <select",
  "350": "            aria-label=\"Filter by status\"",
  "351": "            value={filters.status ?? \"\"}",
  "352": "            onChange={(event) =>",
  "353": "              onFilters({ ...filters, status: event.target.value as ProcessingStatus | \"\", skip: 0 })",
  "354": "            }",
  "355": "          >",
  "356": "            <option value=\"\">All statuses</option>",
  "357": "            {statusOptions.map((status) => (",
  "358": "              <option key={status} value={status}>",
  "359": "                {statusLabels[status]}",
  "360": "              </option>",
  "361": "            ))}",
  "362": "          </select>",
  "363": "          <select",
  "364": "            aria-label=\"Filter by category\"",
  "365": "            value={filters.category ?? \"\"}",
  "366": "            onChange={(event) =>",
  "367": "              onFilters({ ...filters, category: event.target.value as ProductCategory | \"\", skip: 0 })",
  "368": "            }",
  "369": "          >",
  "370": "            <option value=\"\">All categories</option>",
  "371": "            {categoryOptions.map((category) => (",
  "372": "              <option key={category} value={category}>",
  "373": "                {categoryLabels[category]}",
  "374": "              </option>",
  "375": "            ))}",
  "376": "          </select>",
  "377": "          <select",
  "378": "            aria-label=\"Filter by review need\"",
  "379": "            value={filters.needs_review ?? \"\"}",
  "380": "            onChange={(event) =>",
  "381": "              onFilters({ ...filters, needs_review: event.target.value as \"true\" | \"false\" | \"\", skip: 0 })",
  "382": "            }",
  "383": "          >",
  "384": "            <option value=\"\">All review states</option>",
  "385": "            <option value=\"true\">Needs review</option>",
  "386": "            <option value=\"false\">No review need</option>",
  "387": "          </select>",
  "388": "        </div>",
  "389": "",
  "390": "        {queueState === \"loading\" ? (",
  "391": "          <LoadingRows />",
  "392": "        ) : queue?.items.length ? (",
  "393": "          <>",
  "394": "            <div className=\"table-wrap\">",
  "395": "              <table className=\"queue-table\" aria-label=\"Email queue\">",
  "396": "                <thead>",
  "397": "                  <tr>",
  "398": "                    <th scope=\"col\">Sender</th>",
  "399": "                    <th scope=\"col\">Subject</th>",
  "400": "                    <th scope=\"col\">Category</th>",
  "720": "      setReviews(await getHumanReviewQueue());",
  "721": "      setReviewState(\"ready\");",
  "722": "    } catch (caught) {",
  "723": "      setError(caught instanceof Error ? caught.message : \"Unable to load review queue\");",
  "724": "      setReviewState(\"error\");",
  "725": "    }",
  "726": "  }, []);",
  "727": "",
  "728": "  useEffect(() => {",
  "729": "    void loadDashboard();",
  "730": "  }, [loadDashboard]);",
  "731": "",
  "732": "  useEffect(() => {",
  "733": "    if (page === \"review\") {",
  "734": "      void loadReviews();",
  "735": "    }",
  "736": "  }, [loadReviews, page]);",
  "737": "",
  "738": "  useEffect(() => {",
  "739": "    const timer = window.setInterval(async () => {",
  "740": "      try {",
  "741": "        const events = await getEvents(lastEventAt);",
  "742": "        if (events.length > 0) {",
  "743": "          setLastEventAt(events[events.length - 1]?.updated_at);",
  "744": "          void loadDashboard();",
  "745": "        }",
  "746": "      } catch {",
  "747": "        // The header connection state already reflects the latest manual load.",
  "748": "      }",
  "749": "    }, 15000);",
  "750": "    return () => window.clearInterval(timer);",
  "751": "  }, [lastEventAt, loadDashboard]);",
  "752": "",
  "753": "  const selectEmail = async (email: ProductEmailSummary) => {",
  "754": "    setPage(\"queue\");",
  "755": "    setDetailState(\"loading\");",
  "756": "    try {",
  "757": "      setDetail(await getEmailDetail(email.id));",
  "758": "      setDetailState(\"ready\");",
  "759": "    } catch (caught) {",
  "760": "      setError(caught instanceof Error ? caught.message : \"Unable to load email detail\");",
  "761": "      setDetailState(\"error\");",
  "762": "    }",
  "763": "  };",
  "764": "",
  "765": "  const updateFilters = (nextFilters: QueueFilters) => {",
  "766": "    setPageIndex(0);",
  "767": "    setFilters({ ...nextFilters, skip: 0, limit: nextFilters.limit ?? 25 });",
  "768": "  };",
  "769": "",
  "770": "  const movePage = (direction: \"next\" | \"previous\") => {",
  "771": "    const nextIndex = direction === \"next\" ? pageIndex + 1 : Math.max(0, pageIndex - 1);",
  "772": "    const limit = filters.limit ?? 25;",
  "773": "    setPageIndex(nextIndex);",
  "774": "    setFilters({ ...filters, skip: nextIndex * limit, limit });",
  "775": "  };",
  "776": "",
  "777": "  return (",
  "778": "    <div className=\"app-shell\">",
  "779": "      <aside className=\"sidebar\" aria-label=\"Primary navigation\">",
  "780": "        <div className=\"brand\">",
  "781": "          <div className=\"brand-mark\">h</div>",
  "782": "          <div>",
  "783": "            <strong>HolyShip</strong>",
  "784": "            <span>Document Verification</span>",
  "785": "          </div>",
  "786": "        </div>",
  "787": "        <nav>",
  "788": "          <button className={cx(page === \"overview\" && \"active\")} onClick={() => setPage(\"overview\")} type=\"button\">",
  "789": "            <ShipWheel size={18} />",
  "790": "            Overview",
  "791": "          </button>",
  "792": "          <button className={cx(page === \"queue\" && \"active\")} onClick={() => setPage(\"queue\")} type=\"button\">",
  "793": "            <Inbox size={18} />",
  "794": "            Email Queue",
  "795": "          </button>",
  "796": "          <button className={cx(page === \"review\" && \"active\")} onClick={() => setPage(\"review\")} type=\"button\">",
  "797": "            <ClipboardList size={18} />",
  "798": "            Human Review",
  "799": "          </button>",
  "800": "        </nav>",
  "801": "        <div className=\"sidebar-note\">",
  "802": "          <span />",
  "803": "          Backend is the source of truth.",
  "804": "        </div>",
  "805": "      </aside>",
  "806": "",
  "807": "      <main className=\"main-shell\">",
  "808": "        <header className=\"topbar\">",
  "809": "          <div>",
  "810": "            <p className=\"eyebrow\">HolyShip Dashboard</p>",
  "811": "            <h1>{pageTitles[page]}</h1>",
  "812": "          </div>",
  "813": "          <div className=\"topbar-actions\">",
  "814": "            <span className={cx(\"connection\", loadState === \"error\" ? \"offline\" : \"online\")}>",
  "815": "              {loadState === \"error\" ? \"API attention\" : \"API connected\"}",
  "816": "            </span>",
  "817": "            <button className=\"icon-button\" onClick={() => void loadDashboard()} type=\"button\" aria-label=\"Refresh dashboard\">",
  "818": "              <RefreshCw size={18} />",
  "819": "            </button>",
  "820": "          </div>",
  "821": "        </header>",
  "822": "",
  "823": "        {error ? <div className=\"error-banner\" role=\"alert\">{error}</div> : null}",
  "824": "",
  "825": "        {page === \"overview\" ? (",
  "826": "          <OverviewPage",
  "827": "            summary={summary}",
  "828": "            queue={queue}",
  "829": "            state={loadState}",
  "830": "            onOpenQueue={() => setPage(\"queue\")}",
  "831": "          />",
  "832": "        ) : null}",
  "833": "",
  "834": "        {page === \"queue\" ? (",
  "835": "          <QueuePage",
  "836": "            page={pageIndex}",
  "837": "            queue={queue}",
  "838": "            detail={detail}",
  "839": "            detailState={detailState}",
  "840": "            queueState={loadState}",
  "841": "            filters={filters}",
  "842": "            onFilters={updateFilters}",
  "843": "            onSelect={(item) => void selectEmail(item)}",
  "844": "            onPage={movePage}",
  "845": "          />",
  "846": "        ) : null}",
  "847": "",
  "848": "        {page === \"review\" ? (",
  "849": "          <HumanReviewPageView",
  "850": "            reviews={reviews}",
  "851": "            state={reviewState}",
  "852": "            onSelect={(item) => void selectEmail(item)}",
  "853": "          />",
  "854": "        ) : null}",
  "855": "      </main>",
  "856": "    </div>",
  "857": "  );",
  "858": "}",
  "859": ""
